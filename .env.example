# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Renombra este archivo a .env y configura tus valores
# ============================================

# Base de datos MySQL
DB_USER=root
DB_PASSWORD=tu_contraseña_segura_aqui
DB_HOST=localhost
DB_PORT=3306
DB_NAME=PanaderiaBarriosDB

# Servidor
SERVER_PORT=8080

# Spring
SPRING_PROFILES_ACTIVE=dev-mysql

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_PANADERIA=DEBUG
